# Primary AI: Osaurus — local OpenAI-compatible inference (https://docs.osaurus.ai)
OSAURUS_API_URL=http://127.0.0.1:1337
OSAURUS_API_KEY=
OSAURUS_MODEL=foundation

# Fallback 1: claude_local_api — wraps the Claude Code CLI subscription.
# Project: /Users/rexdanquah/Projects/claude_local_api
# Start with: cd /Users/rexdanquah/Projects/claude_local_api && ./start.sh
CLAUDE_LOCAL_API_URL=http://localhost:8765
CLAUDE_LOCAL_PROVIDER=subprocess

# Fallback 2: cursor-api — OpenAI-compatible proxy over the Cursor Agent CLI.
# Project: /Users/rexdanquah/Projects/cursor-api
# Start with: cd /Users/rexdanquah/Projects/cursor-api && npm run dev
# Used automatically when prior providers time out, error, or are unreachable.
CURSOR_API_URL=http://localhost:7878
CURSOR_API_TOKEN=
CURSOR_API_MODEL=auto

# Disable a provider entirely:
# OSAURUS_DISABLED=1
# CLAUDE_LOCAL_DISABLED=1
# CURSOR_API_DISABLED=1

# Override where audit artifacts are stored (default: ./data)
DATA_DIR=

# Path to existing ai_agent outputs/ folder (used by `pnpm run migrate`)
LEGACY_OUTPUTS_DIR=/Users/rexdanquah/Projects/ai_agent/outputs
