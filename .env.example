# Provider 1: Osaurus — local OpenAI-compatible inference (https://docs.osaurus.ai)
OSAURUS_API_URL=http://127.0.0.1:1337
OSAURUS_API_KEY=
OSAURUS_MODEL=foundation

# Provider 2: claude_cli — the `claude` CLI invoked directly as a subprocess.
# No API key: uses your Claude Code login (keychain OAuth). Just have `claude`
# on PATH and be logged in. Optionally point at a non-default binary:
# CLAUDE_CLI_BIN=claude

# Provider 3: cursor-api — OpenAI-compatible proxy over the Cursor Agent CLI.
# Used automatically when prior providers time out, error, or are unreachable.
CURSOR_API_URL=http://localhost:7878
CURSOR_API_TOKEN=
CURSOR_API_MODEL=auto

# Disable a provider entirely (or toggle in Settings → AI provider order):
# OSAURUS_DISABLED=1
# CLAUDE_CLI_DISABLED=1
# CURSOR_API_DISABLED=1

# Override where audit artifacts are stored (default: ./data)
DATA_DIR=

# Path to an existing ai_agent outputs/ folder (used by `pnpm run migrate`)
LEGACY_OUTPUTS_DIR=
