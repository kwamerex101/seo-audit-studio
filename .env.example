# Local Claude API (wraps Claude Code CLI subscription — no API key needed).
# Project: /Users/rexdanquah/Projects/claude_local_api
# Start with: cd /Users/rexdanquah/Projects/claude_local_api && ./start.sh
CLAUDE_LOCAL_API_URL=http://localhost:8765

# Provider used by the local API: subprocess | sdk
CLAUDE_LOCAL_PROVIDER=subprocess

# Set to "1" to disable AI scoring entirely and stay deterministic-only.
# CLAUDE_LOCAL_DISABLED=1

# Override where audit artifacts are stored (default: ./data)
DATA_DIR=

# Path to existing ai_agent outputs/ folder (used by `pnpm run migrate`)
LEGACY_OUTPUTS_DIR=/Users/rexdanquah/Projects/ai_agent/outputs
